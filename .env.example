# =============================================================================
# .env.example - Mẫu cấu hình môi trường ứng dụng BookNest (Nhóm 12)
# Sao chép tệp này thành .env trên máy của bạn và điền thông số thật:
# Windows: copy .env.example .env | Linux/Mac: cp .env.example .env
# =============================================================================

# Chế độ gỡ lỗi (true khi phát triển trên máy cá nhân, false khi chạy chính thức)
APP_DEBUG=true

# Thông tin kết nối MySQL / MariaDB (mặc định XAMPP)
DB_HOST=127.0.0.1
DB_DATABASE=ltweb_nhom12
DB_USERNAME=root
DB_PASSWORD=

# Cấu hình tài khoản quyền tối thiểu (tùy chọn sau khi chạy database/tai-khoan.sql):
# DB_USERNAME=nhom12_app
# DB_PASSWORD=MatKhau_Nhom12_BaoMat2026!
